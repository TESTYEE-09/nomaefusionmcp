+def mcp_result_content_for_model(result: str) -> str | list[dict[str, Any]]:
+    """Convert MCP ImageContent into Studio's normal multimodal parts."""
+    text, images = _split_mcp_image_suffix(result)
+    if not images:
+        return text
+    parts: list[dict[str, Any]] = [{"type": "text", "text": text}]
+    for image in images:
+        parts.append(
+            {
+                "type": "image_url",
+                "image_url": {
+                    "url": f"data:{image['mimeType']};base64,{image['data']}",
+                },
+            }
+        )
+    return parts
 
 
